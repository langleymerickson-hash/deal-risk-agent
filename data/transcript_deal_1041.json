      "topic": "Discussion",
      "sentences": [
        {
          "start": 10700,
          "end": 11500,
          "text": "Good, honestly."
        },
        {
          "start": 11650,
          "end": 18050,
          "text": "I showed a couple of my managers the review template mockup and they were pretty excited."
        },
        {
          "start": 18200,
          "end": 26600,
          "text": "Right now everything lives across shared docs and email threads and half the feedback never actually makes it into one place."
