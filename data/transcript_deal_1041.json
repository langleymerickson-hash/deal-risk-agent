    {
      "speakerId": "427273841618135227089",
      "topic": "Discussion",
      "sentences": [
        {
          "start": 27150,
          "end": 30750,
          "text": "That's exactly the review sprawl problem we talked about."
        },
        {
          "start": 30900,
          "end": 40500,
          "text": "Is the priority more about getting everyone to actually complete reviews on time, or is it more about the quality of the feedback itself?"
