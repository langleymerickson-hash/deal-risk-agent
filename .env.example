ANTHROPIC_API_KEY=sk-ant-...

# Optional. Reference date for "days to close" risk calibration (YYYY-MM-DD).
# Defaults to real wall-clock time — only set this when running against a fixed/
# historical dataset (like the sample data/deals.csv) where close_date values
# should be judged against the data's own snapshot moment, not today's actual date.
ANALYSIS_DATE=2026-07-26
